# ============================================
# Service Account Environment Variables
# Validated at build time by @t3-oss/env-nextjs (env.mjs)
# Populated across phases — see docs/free-tier-budget.md for owning phase
# NEVER commit real values to the repository
# ============================================

# --- Supabase (Phase 1f) ---
# Client-safe: exposed to browser by NEXT_PUBLIC_ prefix
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never reaches client bundle
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash (Phase 1i) ---
# Server-only
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (Phase 3i / 5d) ---
# Server-only: must start with "re_"
RESEND_API_KEY=

# --- Sentry (Phase 10b) ---
# Client-safe: exposed to browser by NEXT_PUBLIC_ prefix
NEXT_PUBLIC_SENTRY_DSN=
# Server-only: used for source map upload at build time
SENTRY_AUTH_TOKEN=
